        "message": "<Chip> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DailySummary'] > JSXAttribute > JSXIdentifier[name!=/^(?:kcal|target|protein|carbs|fat|micros|defaultExpanded|compact|className|key|ref|className|style|children)$/]",
        "message": "<DailySummary> doesn't accept that prop. Declared props: kcal, target, protein, carbs, fat, micros, defaultExpanded, compact, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Dialog'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|title|children|actions|onClose|key|ref|className|style|children)$/]",
        "message": "<Dialog> doesn't accept that prop. Declared props: open, title, children, actions, onClose."
      },
      {
        "selector": "JSXOpeningElement[name.name='FoodItemRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|serving|kcal|confidence|multiplier|onMultiplier|expanded|onToggle|onSwap|onRemove|threshold|className|key|ref|className|style|children)$/]",
        "message": "<FoodItemRow> doesn't accept that prop. Declared props: name, serving, kcal, confidence, multiplier, onMultiplier, expanded, onToggle, onSwap, onRemove, threshold, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|weight|color|className|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, weight, color, className, style."
      },
