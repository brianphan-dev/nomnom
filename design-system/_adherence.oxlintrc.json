        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute[name.name='weight'] > Literal[value!=/^(?:regular|bold|fill)$/]",
        "message": "<Icon> weight must be one of 'regular' | 'bold' | 'fill'."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|label|variant|size|iconSize|weight|disabled|onClick|className|style|key|ref|className|style|children)$/]",
        "message": "<IconButton> doesn't accept that prop. Declared props: icon, label, variant, size, iconSize, weight, disabled, onClick, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:plain|filled|ink|accent|glass)$/]",
        "message": "<IconButton> variant must be one of 'plain' | 'filled' | 'ink' | 'accent' | 'glass'."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='weight'] > Literal[value!=/^(?:regular|bold|fill)$/]",
